# Base URL of the API. Leave unset in development to use the Vite proxy (/api -> localhost:8000).
# VITE_API_BASE_URL=https://api.example.com

# Sign in with Google: the OAuth client ID (same as GOOGLE_CLIENT_ID in the backend .env).
# Leave unset to hide the Google button.
# VITE_GOOGLE_CLIENT_ID=1234-abc.apps.googleusercontent.com
